# Copy to .env (repo root, read by docker compose and scripts/smoke.sh) - never commit .env
# Postgres password (required): the compose `db` service, `make db-migrate` and the stack's DATABASE_URL use it.
POSTGRES_PASSWORD=
# Host ports (defaults 5432 / 8000 / 8080); change them if something already listens there.
POSTGRES_PORT=
API_PORT=
WEB_PORT=
# sim (default) or l1. l1 needs docker-compose.l1.yml and the L1 variables in Backend/.env (docs/DEVELOPMENT.md).
CHAIN_MODE=
# DATABASE_URL of the agent container. Empty on sim (its own in-memory chain must not share the API's tables);
# the l1 override defaults it to the stack's Postgres.
AGENT_DATABASE_URL=
# scripts/smoke.sh: 1 skips the `docker compose restart api` check
SKIP_RESTART=

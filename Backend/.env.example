# Copy to .env - test keys only, never commit .env*
# Empty = in-memory stores. With `make db-up`: postgresql+asyncpg://guardian:<POSTGRES_PASSWORD>@localhost:5432/guardian
DATABASE_URL=
# Local L1 (make l1-local-up): chain id 424242; the RPC URL is printed and saved in infra/l1/.env.l1-local
L1_RPC_URL=
L1_WS_URL=
L1_CHAIN_ID=
CCHAIN_RPC_URL=
L1_EXPLORER_URL=
DEMO_MODE=false
# CHAIN_MODE=l1 (default sim): the file with the deployed addresses (relative to Backend/) and the
# chain ids where DEMO_MODE may sign with test keys (JSON list; default [31337, 424242]).
CHAIN_MODE=sim
DEPLOYMENTS_FILE=deployments/fuji-l1.json
DEMO_CHAIN_IDS=[31337, 424242]
# CHAIN_MODE=l1 signers (testnet/local keys only): one variable per seed id, named
# L1_KEY_ + the seed id in upper case (key_minh -> L1_KEY_KEY_MINH, council_lan -> L1_KEY_COUNCIL_LAN).
# A key must derive the address the seed gives that id, otherwise startup fails.
# Local L1 in one step: `make l1-local-bootstrap` writes Backend/.env.l1-local (all L1_KEY_*, DEPLOYMENTS_FILE and
# GUARDIAN_SEED_FILE from the PUBLIC test mnemonic), then `uv run --env-file .env.l1-local uvicorn guardian.main:app`.
# GUARDIAN_SEED_FILE: a copy of seed/may_labs.json with the key/Council addresses of the target network.
GUARDIAN_SEED_FILE=
COUNCIL_TRANG_PK=
COUNCIL_LAN_PK=
COUNCIL_HUY_PK=
AGENT_REBALANCE_PK=
LLM_PROVIDER=
LLM_API_KEY=
# C-Chain treasury (OPS-002, make deploy-cchain / make topup; docs: contracts/cchain/README.md). Fuji testnet keys only.
# The local run uses anvil's public dev keys and needs none of these. Real values go in Backend/.env.fuji (ignored).
# deployer of the C-Chain contracts (testnet)
CCHAIN_DEPLOYER_KEY=
# multisig owner 1 of 5 (testnet)
CCHAIN_OWNER_KEY_1=
# multisig owner 2 of 5 (testnet)
CCHAIN_OWNER_KEY_2=
# multisig owner 3 of 5 (testnet)
CCHAIN_OWNER_KEY_3=
# multisig owner 4 of 5 (testnet)
CCHAIN_OWNER_KEY_4=
# multisig owner 5 of 5 (testnet)
CCHAIN_OWNER_KEY_5=
# make topup on Fuji: the L1 key that is the tUSDC minter and the vault topUpOperator (the L1 deployer, before handover)
L1_TOPUP_KEY=
# end of C-Chain block

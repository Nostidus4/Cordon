# Copy to .env - test keys only, never commit .env*
DATABASE_URL=postgresql+asyncpg://guardian:guardian@localhost:5432/guardian
# Local L1 (make l1-local-up): chain id 424242; the RPC URL is printed and saved in infra/l1/.env.l1-local
L1_RPC_URL=
L1_WS_URL=
L1_CHAIN_ID=
CCHAIN_RPC_URL=
L1_EXPLORER_URL=
DEMO_MODE=false
# CHAIN_MODE=l1 signers (testnet/local keys only): one variable per seed id, named
# L1_KEY_ + the seed id in upper case (key_minh -> L1_KEY_KEY_MINH, council_lan -> L1_KEY_COUNCIL_LAN).
# A key must derive the address the seed gives that id, otherwise startup fails.
COUNCIL_TRANG_PK=
COUNCIL_LAN_PK=
COUNCIL_HUY_PK=
AGENT_REBALANCE_PK=
LLM_PROVIDER=
LLM_API_KEY=

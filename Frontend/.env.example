# Backend API base (code reads VITE_API_BASE). Relative "/api" (dev proxy) or an absolute URL for a cross-origin backend,
# e.g. https://cordon-guardian-l1.eastasia.cloudapp.azure.com/api (needs CORS_ORIGINS on the backend).
VITE_API_BASE=/api
# Build default mode: mock (in-browser) or live. At runtime ?api=mock|live (saved in localStorage "guardian.apiMode")
# or the toggle in /he-thong overrides it. "live" is offered only when VITE_API_MODE=live or VITE_API_BASE is an absolute http(s) URL.
VITE_API_MODE=mock
# Base URL of a block explorer for tx badges (the code reads VITE_EXPLORER_URL). The Guardian L1 has no public explorer:
# leave it empty and verify hashes with `cast receipt <hash> --rpc-url $RPC` (docs/qa/WEB-004.md).
VITE_EXPLORER_URL=
# Ký bằng ví (chỉ khi VITE_API_MODE=live): để trống thì ẩn nút
VITE_L1_RPC_URL=
VITE_COUNCIL_ADDRESS=
# VITE_L1_CHAIN_ID=845357
# VITE_L1_NATIVE_SYMBOL=GRD

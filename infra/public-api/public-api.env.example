# Copy to /etc/cordon/public-api.env (chmod 640, owner root:cordon). Do NOT commit the real file.
# PUBLIC backend: sim chain only. Never set CHAIN_MODE=l1 and never put a real/funded private key here.
CHAIN_MODE=sim
DEMO_MODE=true
# Empty = in-memory state (reset on restart, which is what we want for a shared public demo).
DATABASE_URL=
# JSON list (pydantic-settings). Allow the GitHub Pages origin (no path, no trailing slash).
CORS_ORIGINS=["https://nostidus4.github.io"]
# Per-client limit for signing/demo endpoints (POST). Keyed by client IP (X-Forwarded-For from Caddy).
RATE_LIMIT_PER_MINUTE=60
# Optional: if set, every signing POST needs header X-Demo-Token, which the static Pages site cannot keep secret.
# Leave empty on the public demo (the rate limit is the guard).
DEMO_SIGNING_TOKEN=
# The 3D city/agent loop run on the sim chain.
SCENARIO_DELAY_SECONDS=3

# --- LLM: OFF. Paid LLM keys must NOT be set on the public host (anyone could burn the budget). ---
# Without a key the assistant answers from templates. Do not add ANTHROPIC_API_KEY here.
LLM_ENABLED=false
# ANTHROPIC_API_KEY=   <- intentionally absent
